
    <main class="container account-container">
        <h1>Create Account</h1>
        <form action="login.html">
            <div class="form-group"><label>Name</label><input type="text" required></div>
            <div class="form-group"><label>Email</label><input type="email" required></div>
            <div class="form-group"><label>Password</label><input type="password" required></div>
            <button type="submit" class="btn" style="width: 100%;">Sign Up</button>
            <a href="/login/" class="btn btn-dark" style="width: 100%; margin-top: 15px; display: block;">Back to Login</a>
        </form>
    </main>