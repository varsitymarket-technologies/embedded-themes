<!-- Vanilla JS for Tab Switching -->
<script>
    function switchTab(tabId) {
        // 1. Hide all panes
        const panes = document.querySelectorAll('.tab-pane');
        panes.forEach(pane => {
            pane.classList.remove('block');
            pane.classList.add('hidden');
        });

        // 2. Show the selected pane
        document.getElementById('pane-' + tabId).classList.remove('hidden');
        document.getElementById('pane-' + tabId).classList.add('block');

        // 3. Reset all buttons to inactive state
        const buttons = document.querySelectorAll('.tab-btn');
        buttons.forEach(btn => {
            btn.className = "tab-btn flex items-center space-x-3 px-4 py-3 text-gray-600 hover:text-black hover:bg-gray-50 border-b-2 md:border-b-0 md:border-l-2 border-transparent hover:border-black transition-all whitespace-nowrap";
        });

        // 4. Set the clicked button to active state
        const activeBtn = document.getElementById('btn-' + tabId);
        activeBtn.className = "tab-btn flex items-center space-x-3 px-4 py-3 bg-black text-white border-b-2 md:border-b-0 md:border-l-2 border-black transition-all whitespace-nowrap";
        
        // Ensure the active button icon is the correct color (Lucide inherits text color, but force it just in case)
        lucide.createIcons(); // Re-render icons if necessary to pick up new stroke colors
    }
</script>