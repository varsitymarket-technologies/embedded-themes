                    app()->create_shop_ui(array_values($res));
                }
                -->
            </div>
        <?php endif; ?>
    <?php else: ?>
        <div class="text-center py-12 text-gray-600">
            <p class="text-sm">Enter a search term to get started</p>
        </div>
    <?php endif; ?>
</section>
