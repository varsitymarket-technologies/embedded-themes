<?php
$email       = trim($_GET['email'] ?? $_POST['email'] ?? '');
$order_data  = null;
if (!empty($email)) {
    $order_data = api()->async_order($email);
}
?>

<section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24">
    <h1 class="font-display text-4xl font-bold text-black mb-12">Track Order</h1>

    <form method="GET" action="/orders" class="mb-12">
        <div class="flex gap-0 border border-gray-300">
            <input type="email" name="email" value="<?= htmlspecialchars($email) ?>"
                placeholder="Enter your email"
                class="flex-1 bg-white px-6 py-4 text-sm outline-none focus:bg-gray-50 transition-colors">
            <button type="submit" class="bg-black text-white px-8 py-4 text-sm font-semibold hover:bg-gray-800 transition-colors">
                Search
            </button>
        </div>
    </form>

    <?php if (!empty($email)): ?>
        <?php if (empty($order_data)): ?>
            <div class="text-center py-12">
                <i data-lucide="inbox" class="w-12 h-12 text-gray-300 mx-auto mb-4"></i>
                <p class="font-display text-2xl text-black mb-2">No orders found</p>
                <p class="text-gray-600 text-sm mb-6">No orders for <?= htmlspecialchars($email) ?></p>
                <a href="/shop" class="inline-block border border-black text-black px-6 py-2 text-sm font-semibold hover:bg-black hover:text-white transition-colors">
                    Continue Shopping
                </a>
            </div>
        <?php else: ?>
            <div class="space-y-4">
                <?php
                $orders = is_array($order_data) && isset($order_data[0]) ? $order_data : [$order_data];
                foreach ($orders as $order):
                ?>
                <div class="border border-gray-200 p-6">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <p class="text-xs uppercase text-gray-600 font-semibold mb-1">Order #<?= htmlspecialchars($order['id'] ?? 'N/A') ?></p>
                            <p class="font-medium text-black"><?= htmlspecialchars($order['created_at'] ?? '') ?></p>
                        </div>
                        <span class="text-xs uppercase font-semibold px-3 py-1 bg-gray-100 text-gray-700">
                            <?= htmlspecialchars($order['status'] ?? 'Processing') ?>
                        </span>
                    </div>
                    <p class="text-sm text-gray-600">Total: <span class="text-black font-semibold"><?= htmlspecialchars($order['total'] ?? 'R0.00') ?></span></p>
                </div>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
    <?php else: ?>
        <div class="text-center py-12">
            <p class="text-gray-600">Enter your email address to track your orders</p>
        </div>
    <?php endif; ?>
</section>
