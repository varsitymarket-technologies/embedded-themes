<?php
$cat = trim((string)($_GET['cat'] ?? ($GLOBALS['cat'] ?? '')));
$products = api()->async_products();

if ($cat !== '') {
    $products = array_values(array_filter($products, function ($item) use ($cat) {
        $itemCat = strtolower(trim((string)($item['category'] ?? $item['category_name'] ?? '')));
        return $itemCat === strtolower($cat);
    }));
}
