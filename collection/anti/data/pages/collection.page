<?php
$raw_categories = api()->async_categories();
$collection_categories = [];

foreach ((array) $raw_categories as $category) {
  if (is_object($category)) {
    $category = (array) $category;
  }

  if (is_string($category)) {
    $category = [
      'name' => $category,
      'description' => '',
      'image' => './index_files/logo.png',
    ];
  }

  if (!is_array($category)) {
    continue;
  }

  $collection_categories[] = [
    'name' => $category['name'] ?? $category['title'] ?? $category['category_name'] ?? 'UNTITLED',
    'description' => $category['description'] ?? '',
    'image' => $category['image'] ?? './index_files/logo.png',
  ];
}
