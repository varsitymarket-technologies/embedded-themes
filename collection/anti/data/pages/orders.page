<section class="py-16 sm:py-20">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="border border-[#1A1A1A] bg-[#030303] overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-4 p-8 sm:p-12 border-b lg:border-b-0 lg:border-r border-[#1A1A1A] bg-[#0A0A0A]">
          <span class="font-mono text-[10px] tracking-[0.35em] text-[#666] mb-5 block">[ ORDERS / TRACKING ]</span>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter leading-[0.92] uppercase">
            TRACK<br>ORDER
          </h1>
          <p class="font-mono text-[11px] text-[#888] leading-7 lowercase mt-6">
            search your order status using the email tied to the purchase.
          </p>
        </div>
        <div class="lg:col-span-8 p-8 sm:p-12 lg:p-16">
          <form class="flex flex-col sm:flex-row gap-3 mb-8">
            <input type="email" placeholder="Enter your email" class="flex-1 px-4 py-4 shopify-input bg-[#030303]">
            <button class="py-4 px-6 btn-invert font-mono text-[11px] tracking-widest border border-transparent">SEARCH</button>
          </form>
          <div class="space-y-px bg-[#1A1A1A] border border-[#1A1A1A]">
            <div class="bg-[#030303] p-6 sm:p-8">
              <div class="flex justify-between items-start gap-6 mb-4">
                <div>
                  <p class="font-semibold tracking-wide text-white">Order #1001</p>
                  <p class="font-mono text-[10px] text-[#666] mt-1">July 31, 2026</p>
                </div>
                <span class="text-[10px] uppercase font-mono tracking-widest px-3 py-1 border border-[#333] text-[#bbb]">Processing</span>
              </div>
              <p class="font-mono text-[10px] text-[#888] tracking-widest">TOTAL: R0.00</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
