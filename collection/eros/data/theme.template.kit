<?php

function template()
{
  return new class {
    public function return_shop($state = "products")
    {
      $product_template = '
            <article class="group bg-[#030303] cursor-pointer hover:bg-[#0A0A0A] transition-colors relative flex flex-col h-full">
              <div class="absolute top-4 left-4 z-10 font-mono text-[9px] bg-black border border-[#333] px-2 py-1 text-[#666]">
                (#item_id)
              </div>
              <div class="aspect-[3/4] w-full overflow-hidden bg-[#0A0A0A]">
                <a href="<!-- #!/engine/node/ page(\'product\') -->/(#item_id)" class="block w-full h-full">
                  <img src="(#item_image)" alt="(#item_name)" class="w-full h-full object-cover grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500">
                </a>
              </div>
              <div class="p-4 border-t border-[#1A1A1A] flex flex-col flex-grow justify-between gap-4">
                <div>
                  <h3 class="font-bold text-sm tracking-tight leading-snug text-white">(#item_name)</h3>
                  <p class="font-mono text-[9px] text-[#666] tracking-widest mt-1">(#item_category)</p>
                </div>
                <div class="font-mono text-[11px] text-white">
                  (#item_price)
                </div>
              </div>
            </article>';

      $product_input = ['(#item_id)', '(#item_name)', '(#item_description)', '(#item_image)', '(#item_price)', '(#item_category)'];

      return $state === 'products' ? $product_template : $product_input;
    }

    public function return_related_shop($state = "products")
    {
      $product_template = '
            <article class="group bg-[#030303] border border-[#1A1A1A] hover:bg-[#0A0A0A] transition-colors overflow-hidden">
              <a href="<!-- #!/engine/node/ page(\'product\') -->/(#item_id)" class="block">
                <div class="aspect-[3/4] overflow-hidden bg-[#0A0A0A]">
                  <img src="(#item_image)" alt="(#item_name)" class="w-full h-full object-cover grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500">
                </div>
                <div class="p-4 border-t border-[#1A1A1A]">
                  <h3 class="font-bold text-sm tracking-tight leading-snug text-white">(#item_name)</h3>
                  <p class="font-mono text-[9px] text-[#666] tracking-widest mt-1">(#item_category)</p>
                  <div class="font-mono text-[11px] text-white mt-3">(#item_price)</div>
                </div>
              </a>
            </article>';

      $product_input = ['(#item_id)', '(#item_name)', '(#item_description)', '(#item_image)', '(#item_price)', '(#item_category)'];

      return $state === 'products' ? $product_template : $product_input;
    }

    public function return_category($state = "categories")
    {
      $category_template = '
            <a href="<!-- #!/engine/node/ page(\'shop\') -->?cat=(#cat_name)" class="group bg-[#030303] hover:bg-[#0A0A0A] transition-colors border border-[#1A1A1A] overflow-hidden">
              <div class="aspect-[4/5] overflow-hidden bg-[#0A0A0A]">
                <img src="(#cat_image)" alt="(#cat_name)" class="w-full h-full object-cover grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500">
              </div>
              <div class="p-5 border-t border-[#1A1A1A]">
                <h3 class="text-lg font-semibold tracking-wide text-white mb-1">(#cat_name)</h3>
                <p class="font-mono text-[9px] text-[#666] tracking-widest">VIEW COLLECTION</p>
              </div>
            </a>';

      $category_input = ['(#cat_name)', '(#cat_description)', '(#cat_image)'];

      return $state === 'categories' ? $category_template : $category_input;
    }

    public function return_product($state = "products")
    {
      $product_template = '
            <section class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20">
                <div class="bg-gray-100 aspect-square overflow-hidden sticky top-20">
                    <img src="(#item_image)" alt="(#item_name)" class="w-full h-full object-cover">
                </div>
                <div class="flex flex-col justify-center">
                    <p class="text-xs uppercase tracking-wider text-gray-600 font-semibold mb-3">(#item_category)</p>
                    <h1 class="font-display text-5xl font-bold text-black mb-6">(#item_name)</h1>
                    <p class="text-3xl font-light text-gray-900 mb-8">(#item_price)</p>
                    <p class="text-gray-600 text-base leading-relaxed mb-12">(#item_desc)</p>
                </div>
            </section>';

      $product_input = ['(#item_id)', '(#item_name)', '(#item_desc)', '(#item_image)', '(#item_price)', '(#item_category)'];

      return $state === 'products' ? $product_template : $product_input;
    }
  };
}
