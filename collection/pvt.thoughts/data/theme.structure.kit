<?php

function app()
{
    return new class {
        public function create_shop_ui($products)
        {
            $output = "";
            $shop_template = template()->return_shop();

            foreach ($products as $value) {
                if (is_object($value)) {
                    $value = (array) $value;
                }

                $build = str_ireplace(
                    template()->return_shop('id'),
                    [
                        $value['id'] ?? '',
                        $value['name'] ?? ($value['title'] ?? ''),
                        $value['description'] ?? ($value['desc'] ?? ''),
                        $value['image'] ?? '',
                        $value['price'] ?? '',
                        $value['category'] ?? ($value['category_name'] ?? '')
                    ],
                    $shop_template
                );

                $output .= $build;
            }

            return print($output);
        }

        public function create_related_products_ui($products)
        {
            $output = "";
            $shop_template = template()->return_related_shop();

            foreach ($products as $value) {
                if (is_object($value)) {
                    $value = (array) $value;
                }

                $build = str_ireplace(
                    template()->return_related_shop('id'),
                    [
                        $value['id'] ?? '',
                        $value['name'] ?? ($value['title'] ?? ''),
                        $value['description'] ?? ($value['desc'] ?? ''),
                        $value['image'] ?? '',
                        $value['price'] ?? '',
                        $value['category'] ?? ($value['category_name'] ?? '')
                    ],
                    $shop_template
                );

                $output .= $build;
            }

            return print($output);
        }

        public function create_product_ui($product)
        {
            $output = "";
            $product_template = template()->return_product();

            if (is_object($product)) {
                $product = (array) $product;
            }

            $build = str_ireplace(
                template()->return_product('id'),
                [
                    $product['id'] ?? '',
                    $product['name'] ?? ($product['title'] ?? ''),
                    $product['description'] ?? ($product['desc'] ?? ''),
                    $product['image'] ?? '',
                    $product['price'] ?? '',
                    $product['category_name'] ?? ($product['category'] ?? '')
                ],
                $product_template
            );

            $output .= $build;

            return print($output);
        }

        public function create_category_ui($categories)
        {
            $output = "";
            $category_template = template()->return_category();

            foreach ($categories as $value) {
                if (is_object($value)) {
                    $value = (array) $value;
                }

                if (is_string($value)) {
                    $value = [
                        'name' => $value,
                        'description' => '',
                        'image' => './index_files/logo.png',
                    ];
                }

                if (!is_array($value)) {
                    continue;
                }

                $build = str_ireplace(
                    template()->return_category('id'),
                    [
                        $value['name'] ?? '',
                        $value['description'] ?? '',
                        $value['image'] ?? './index_files/logo.png',
                    ],
                    $category_template
                );

                $output .= $build;
            }

            return print($output);
        }

        public function card($name)
        {
            $path = __DIR__ . "/{$name}.card";
            return file_exists($path) ? file_get_contents($path) : "";
        }
    };
}
