<!-- #/engine/navbar/encode/:BEGIN -->

    <!-- Header Navigation -->
    <header>
        <div class="container nav-container">
            <a href="?page=home" class="logo">
                <img src="https://hastings-ego.github.io/pvt/assets/logo-white.png" style="filter: invert(1); max-width: 4rem; ">
            </a>

            <ul class="nav-links">
                <li><a href="/?page=about" class="nav-link">About</a></li>
                <li><a href="/?page=shop" class="nav-link">Shop</a></li>
                <li><a href="/?page=collection" class="nav-link">Collection</a></li>
                <li><a href="/?page=contact" class="nav-link">Contact</a></li>

            <div class="nav-actions" style="display: flex; gap: 0.75rem;">
                <a href="/?page=cart" class="btn btn-outline"><i data-lucide="shopping-bag" size="16"></i> Cart</a>
                <a href="/?page=signup" class="btn btn-acid">Sign In</a>
            </div>


            </ul>

            <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle Menu">
                <i data-lucide="menu"></i>
            </button>
        </div>
    </header>

    <!-- Mobile Drawer -->
    <div class="mobile-menu" id="mobileMenu">
        <a href="/?page=about" class="nav-link">About</a>
        <a href="/?page=shop" class="nav-link">Shop</a>
        <a href="/?page=collection" class="nav-link">Collection</a>
        <a href="/?page=contact" class="nav-link">Contact</a>
        <hr style="border: none; border-top: 1px solid var(--border-medium);">
        <a href="/?page=cart" class="btn btn-outline" style="width: 100%;">Cart </a>
        <a href="/?page=signup" class="btn btn-acid" style="width: 100%;">Sign In</a>
    </div>

<!-- #/engine/navbar/encode/:END; -->
