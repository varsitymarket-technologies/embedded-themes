<?php
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

$_SESSION['store'] = $_SESSION['store'] ?? [
    'customer' => ['name' => '', 'email' => '', 'phone' => '', 'address' => '', 'city' => '', 'state' => '', 'zip' => ''],
    'cart' => [],
    'orders' => [],
];

$store = &$_SESSION['store'];
$cart = $store['cart'];
$customer = $store['customer'];
$shipping = 150.00;
$subtotal = 0.00;

foreach ($cart as $item) {
    $subtotal += ((float)($item['price'] ?? 0)) * ((int)($item['qty'] ?? 1));
}

$paymentMethod = 'card';
$orderSuccess = false;
$orderNumber = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $customer = [
        'name' => trim((string)($_POST['full_name'] ?? '')),
        'email' => trim((string)($_POST['email'] ?? '')),
        'phone' => trim((string)($_POST['phone'] ?? '')),
        'address' => trim((string)($_POST['address'] ?? '')),
        'city' => trim((string)($_POST['city'] ?? '')),
        'state' => trim((string)($_POST['state'] ?? '')),
        'zip' => trim((string)($_POST['zip'] ?? '')),
    ];

    $paymentMethod = trim((string)($_POST['payment_method'] ?? 'card'));
    $paymentReference = 'pay_' . strtoupper(bin2hex(random_bytes(4)));
    $orderNumber = 'ORD-' . strtoupper(bin2hex(random_bytes(3)));

    $order = [
        'order_number' => $orderNumber,
        'payment_reference' => $paymentReference,
        'payment_method' => $paymentMethod,
        'customer' => $customer,
        'items' => $cart,
        'subtotal' => $subtotal,
        'shipping' => $shipping,
        'total' => $subtotal + $shipping,
        'status' => 'processing',
        'created_at' => date('Y-m-d H:i:s'),
    ];

    $store['customer'] = $customer;
    $store['orders'][] = $order;
    $store['last_order'] = $order;
    $store['checkout_status'] = 'completed';

    setcookie('pvt_customer_email', $customer['email'], time() + (86400 * 30), '/');
    setcookie('pvt_last_order', $orderNumber, time() + (86400 * 30), '/');
    $orderSuccess = true;
}
