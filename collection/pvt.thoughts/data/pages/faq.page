<main class="policy-section">
    <div class="container" style="max-width: 900px; padding-top: 2rem; padding-bottom: 4rem;">
        
        <!-- Header & Breadcrumbs -->
        <div class="policy-header" style="text-align: center; max-width: 680px; margin: 0 auto 2.5rem auto;">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-subtle); margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                <a href="#" style="color: var(--text-subtle); text-decoration: none;">Index</a> 
                <i data-lucide="chevron-right" size="12"></i> 
                <span style="color: var(--text-main);">Support</span>
            </div>
            <h1 class="policy-title" style="font-size: clamp(2.25rem, 4.5vw, 3.25rem); margin-bottom: 0.75rem;">
                Frequently Asked Questions
            </h1>
            <p class="policy-meta" style="font-size: 0.9375rem;">
                Everything you need to know about drop mechanics, shipping across South Africa, payment gateways, and garment maintenance.
            </p>

            <!-- Search Bar -->
            <div style="position: relative; margin-top: 1.75rem; width: 100%;">
                <i data-lucide="search" size="16" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-subtle);"></i>
                <input type="text" placeholder="Search keywords (e.g. shipping, 450GSM, Capitec Pay, returns)..." style="width: 100%; padding: 0.875rem 1rem 0.875rem 2.75rem; border: 1px solid var(--border-medium); border-radius: var(--radius-sm); background: var(--bg-card-subtle); color: var(--text-main); font-size: 0.875rem; outline: none;">
            </div>
        </div>

        <!-- Category Anchor Pills -->
        <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
            <a href="#shipping" class="btn btn-acid" style="padding: 0.5rem 1rem; font-size: 0.75rem;">Shipping & Delivery</a>
            <a href="#payments" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.75rem;">Payments & Security</a>
            <a href="#sizing" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.75rem;">Sizing & Care</a>
            <a href="#drops" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.75rem;">Drop Mechanics</a>
            <a href="#returns" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.75rem;">Returns & Exchanges</a>
        </div>

        <!-- FAQ Categories Container -->
        <div style="display: flex; flex-direction: column; gap: 2.5rem;">

            <!-- Category 1: Shipping & Delivery -->
            <section id="shipping">
                <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-medium);">
                    <i data-lucide="truck" size="20" style="color: var(--acid);"></i>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">
                        1. Shipping & Delivery
                    </h2>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    
                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>How long does domestic shipping take within South Africa?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            Orders within Gauteng typically arrive within 1–2 business days. Major hubs (Cape Town, Durban, Gqeberha) take 2–3 business days, while regional/outlying areas take 3–5 business days. All orders are dispatched via tracked courier directly from our Midrand warehouse.
                        </div>
                    </details>

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>How do I track my order status?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            Once your parcel is scanned out of our facility, you will receive an automated email and SMS containing a waybill number and direct tracking link. You can also view live fulfillment progress under your account dashboard.
                        </div>
                    </details>

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>Do you ship internationally?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            Yes. International express shipping is handled via DHL Express (3–7 business days worldwide). Duties and import taxes are calculated at checkout depending on your destination country.
                        </div>
                    </details>

                </div>
            </section>

            <!-- Category 2: Payments & Billing -->
            <section id="payments">
                <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-medium);">
                    <i data-lucide="credit-card" size="20" style="color: var(--acid);"></i>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">
                        2. Payments & Security
                    </h2>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem;">

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>What payment methods are supported at checkout?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            We accept all major VISA and Mastercard credit/debit cards, Ozow Instant EFT, Capitec Pay, PayFast, and Stitch API integrations. All transactions are 3D-Secure encrypted for maximum safety.
                        </div>
                    </details>

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>Why was my payment declined during a drop launch?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            High-volume drop events can trigger temporary bank safety locks if 3D-Secure authentication takes longer than 3 minutes. We recommend ensuring your banking app notifications are enabled prior to launch or using Instant EFT / Capitec Pay for immediate reservation.
                        </div>
                    </details>

                </div>
            </section>

            <!-- Category 3: Garment Sizing & Care -->
            <section id="sizing">
                <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-medium);">
                    <i data-lucide="scissors" size="20" style="color: var(--acid);"></i>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">
                        3. Sizing & Garment Engineering
                    </h2>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem;">

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>How do DROPSTUDIO garments fit?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            Our apparel features a custom oversized, boxy industrial fit with dropped shoulders and heavy structured drapes. We recommend purchasing your standard true-to-size for an intentionally relaxed silhouette, or sizing down if you prefer a traditional tailored fit.
                        </div>
                    </details>

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>How should I wash my 450GSM French Terry items?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            Wash inside-out in cold water (30°C max) on a gentle cycle. Air dry flat to prevent heavy wet cotton from stretching. Never tumble dry or iron directly over raised rubberized or puff print graphics.
                        </div>
                    </details>

                </div>
            </section>

            <!-- Category 4: Drop Mechanics & Anti-Bot Protection -->
            <section id="drops">
                <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-medium);">
                    <i data-lucide="shield-alert" size="20" style="color: var(--acid);"></i>
                    <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0; text-transform: uppercase; letter-spacing: 0.05em;">
                        4. Drop Mechanics & Fair Access
                    </h2>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem;">

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>How do password-gated drops work?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            30 minutes prior to a scheduled release, the site locks. VIP newsletter subscribers receive a access passcode via SMS/Email 5 minutes before official launch to guarantee early queue entry.
                        </div>
                    </details>

                    <details class="card-machined policy-card" style="padding: 0; overflow: hidden; background: var(--bg-card);">
                        <summary style="padding: 1.25rem 1.5rem; font-weight: 700; font-size: 0.9375rem; color: var(--text-main); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; user-select: none;">
                            <span>Are restocks guaranteed for sold out garments?</span>
                            <i data-lucide="chevron-down" size="18" style="color: var(--text-subtle);"></i>
                        </summary>
                        <div style="padding: 0 1.5rem 1.25rem 1.5rem; border-top: 1px solid var(--border-light); font-size: 0.875rem; color: var(--text-subtle); line-height: 1.6; margin-top: 0.75rem;">
                            No. To maintain quality control and exclusivity, drops are limited to fixed manufacturing quantities. Core baseline items may restock seasonally, but main drop capsules will not be re-produced.
                        </div>
                    </details>

                </div>
            </section>

        </div>

        <!-- Help Desk & Contact Support Callout Banner -->
        <div class="card-machined policy-card" style="padding: 2.5rem 2rem; margin-top: 4rem; background: var(--bg-card-subtle); text-align: center; border: 1px solid var(--border-medium);">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--bg-card); border: 1px solid var(--acid); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto; color: var(--acid);">
                <i data-lucide="headphones" size="24"></i>
            </div>
            <h3 style="font-size: 1.375rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">
                Still Have Unanswered Questions?
            </h3>
            <p style="font-size: 0.875rem; color: var(--text-subtle); max-width: 480px; margin: 0 auto 1.75rem auto; line-height: 1.6;">
                Our studio engineering & support team in Midrand is available Monday to Friday, 08:00 – 17:00 SAST.
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="#" class="btn btn-acid" style="padding: 0.75rem 1.5rem; font-size: 0.8125rem;">
                    <i data-lucide="mail" size="16"></i> Email Support Desk
                </a>
                <a href="#" class="btn btn-outline" style="padding: 0.75rem 1.5rem; font-size: 0.8125rem;">
                    <i data-lucide="message-square" size="16"></i> Join Discord HQ
                </a>
            </div>
        </div>

    </div>
</main>
