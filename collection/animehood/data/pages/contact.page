<section class="py-16">
  <div class="container mx-auto px-4 max-w-4xl">
    <h1 class="text-4xl font-bold mb-6">Contact Us</h1>
    <p class="text-gray-600 mb-8">Questions about an order, shipping, or our collection? Send us a message below.</p>
    <form class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <input type="text" placeholder="Full Name" class="md:col-span-1 px-4 py-3 border border-gray-200 rounded-lg">
      <input type="email" placeholder="Email Address" class="md:col-span-1 px-4 py-3 border border-gray-200 rounded-lg">
      <input type="text" placeholder="Order Number (Optional)" class="md:col-span-1 px-4 py-3 border border-gray-200 rounded-lg">
      <select class="md:col-span-1 px-4 py-3 border border-gray-200 rounded-lg">
        <option>General Inquiry</option>
        <option>Orders & Shipping</option>
        <option>Returns & Exchanges</option>
        <option>Wholesale & Press</option>
      </select>
      <textarea rows="6" placeholder="How can we help?" class="md:col-span-2 px-4 py-3 border border-gray-200 rounded-lg"></textarea>
      <button class="md:col-span-2 py-3 px-6 bg-primary text-white rounded-button">Send Message</button>
    </form>
  </div>
</section>
