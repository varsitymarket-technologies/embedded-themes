<section class="py-16">
  <div class="container mx-auto px-4 max-w-md">
    <h1 class="text-3xl font-bold mb-8">Create Account</h1>
    <form class="space-y-4">
      <input type="text" placeholder="Name" class="w-full px-4 py-3 border border-gray-200 rounded-lg">
      <input type="email" placeholder="Email" class="w-full px-4 py-3 border border-gray-200 rounded-lg">
      <input type="password" placeholder="Password" class="w-full px-4 py-3 border border-gray-200 rounded-lg">
      <button class="w-full py-3 px-6 bg-primary text-white rounded-button">Sign Up</button>
    </form>
  </div>
</section>
