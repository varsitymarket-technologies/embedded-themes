      <input type="hidden" name="product_id" value="<?= (int)($product['id'] ?? $product_id) ?>">
      <input type="hidden" name="product_name" value="<?= htmlspecialchars($product['name'] ?? '') ?>">
      <input type="hidden" name="product_price" value="<?= htmlspecialchars($product['price'] ?? '') ?>">
      <input type="hidden" name="product_image" value="<?= htmlspecialchars($product['image'] ?? '') ?>">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
        <input type="number" name="quantity" min="1" value="1" class="w-24 px-4 py-3 border border-gray-200 rounded-lg">
      </div>
      <button type="submit" class="py-3 px-6 bg-primary text-white rounded-button">Add to Cart</button>
    </form>
