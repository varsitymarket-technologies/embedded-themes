<?php
$cart = $_SESSION['cart'] ?? [];
$total = 0.0;
foreach ($cart as $item) {
    $raw = preg_replace('/[^0-9.]/', '', $item['price'] ?? '0');
    $total += (float)$raw * (int)($item['qty'] ?? 1);
}
?>
<section class="py-16">
  <div class="container mx-auto px-4 max-w-5xl">
    <h1 class="text-3xl font-bold mb-8">Checkout</h1>
    <?php if (empty($cart)): ?>
      <p class="text-gray-600 mb-4">Your cart is empty.</p>
      <a href="<!-- #!/engine/node/ page('shop') -->" class="inline-block py-3 px-6 bg-primary text-white rounded-button">Go Shopping</a>
    <?php else: ?>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <form method="POST" action="/orders" class="space-y-4">
          <input type="hidden" name="action" value="place_order">
          <input type="text" name="first_name" placeholder="First name" class="w-full px-4 py-3 border border-gray-200 rounded-lg" required>
          <input type="text" name="last_name" placeholder="Last name" class="w-full px-4 py-3 border border-gray-200 rounded-lg" required>
          <input type="email" name="email" placeholder="Email" class="w-full px-4 py-3 border border-gray-200 rounded-lg" required>
          <input type="text" name="address" placeholder="Address" class="w-full px-4 py-3 border border-gray-200 rounded-lg" required>
          <button type="submit" class="py-3 px-6 bg-primary text-white rounded-button">Complete Purchase</button>
        </form>
        <div class="bg-gray-50 rounded-lg p-6">
          <h2 class="text-2xl font-semibold mb-4">Order Summary</h2>
          <div class="space-y-3 mb-6">
            <?php foreach ($cart as $item): ?>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600"><?= htmlspecialchars($item['name'] ?? '') ?> x<?= (int)($item['qty'] ?? 1) ?></span>
                <span class="text-gray-900"><?= htmlspecialchars($item['price'] ?? '') ?></span>
              </div>
            <?php endforeach; ?>
          </div>
          <div class="border-t border-gray-200 pt-4 flex justify-between font-semibold">
            <span>Total</span>
            <span>R<?= number_format($total, 2) ?></span>
          </div>
        </div>
      </div>
    <?php endif; ?>
  </div>
</section>
